# =============================================================================
# Environment template — safe to commit to GitHub (no real secrets)
#
# Setup:
#   1. Copy this file to `.env` (`.env` is gitignored and holds YOUR keys)
#   2. Replace placeholder values below
#
# Windows:  copy .env.example .env
# macOS/Linux:  cp .env.example .env
# =============================================================================

# Cal.com — required
CALCOM_API_KEY=

# Event type: use ID (recommended) OR slug + username
CALCOM_EVENT_TYPE_ID=
# CALCOM_EVENT_TYPE_SLUG=30min
# CALCOM_USERNAME=your-cal-username

# Defaults for booking and display
DEFAULT_TIMEZONE=America/Los_Angeles
DEFAULT_ATTENDEE_NAME=Demo User
DEFAULT_ATTENDEE_EMAIL=demo@example.com

# OpenAI — required for natural-language parsing
OPENAI_API_KEY=
# Omit OPENAI_BASE_URL to use https://api.openai.com/v1
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
